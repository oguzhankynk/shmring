# Minimal Doxygen configuration for this template. Unlisted tags keep
# Doxygen's defaults. Generated from this template by cmake/Doxygen.cmake;
# the two @SHMRING_DOXYGEN_*@ placeholders below are the only things that
# differ between the 'docs' and 'docs-check' targets.

PROJECT_NAME           = "shmring"
PROJECT_NUMBER         = "@SHMRING_VERSION@"
PROJECT_BRIEF          = "A modern C++ project template"
OUTPUT_DIRECTORY       = "@SHMRING_DOXYGEN_OUTPUT_DIR@"

INPUT                  = "@SHMRING_SOURCE_DIR@/include" \
                          "@SHMRING_SOURCE_DIR@/src" \
                          "@SHMRING_SOURCE_DIR@/docs/mainpage.md"
FILE_PATTERNS           = *.hpp *.h *.md
RECURSIVE               = YES
EXCLUDE_PATTERNS        = */_deps/* */tests/* */build/*
USE_MDFILE_AS_MAINPAGE  = "@SHMRING_SOURCE_DIR@/docs/mainpage.md"
STRIP_FROM_PATH         = "@SHMRING_SOURCE_DIR@"

EXTRACT_ALL             = NO
EXTRACT_PRIVATE         = NO
EXTRACT_STATIC          = NO
HIDE_UNDOC_MEMBERS      = NO
HIDE_UNDOC_CLASSES      = NO
WARN_IF_UNDOCUMENTED    = YES
WARN_IF_DOC_ERROR       = YES
WARN_NO_PARAMDOC        = YES
WARN_AS_ERROR           = @SHMRING_DOXYGEN_WARN_AS_ERROR@

GENERATE_HTML           = @SHMRING_DOXYGEN_GENERATE_HTML@
GENERATE_LATEX          = NO
GENERATE_XML            = NO
SOURCE_BROWSER          = YES
HAVE_DOT                = @SHMRING_DOXYGEN_HAVE_DOT@
QUIET                   = YES
